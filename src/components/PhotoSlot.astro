---
// Shows assets/photos/<name>.jpg if it exists, otherwise a labelled placeholder.
// Drop a correctly named file into assets/photos/ and rebuild: no code changes.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  brief: string;
  alt: string; // "" for decorative photos
  ratio?: string; // CSS aspect-ratio, e.g. "4/5". Ignored for variant="background".
  variant?: 'block' | 'background';
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  name,
  brief,
  alt,
  ratio = '16/9',
  variant = 'block',
  sizes = '100vw',
  priority = false,
  class: className,
} = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/assets/photos/*.{jpg,jpeg,JPG,JPEG}', {
  eager: true,
});
const match = Object.entries(photos).find(([file]) => {
  const base = file.split('/').pop() ?? '';
  return base.replace(/\.jpe?g$/i, '') === name;
});
const image = match?.[1].default;
const widths = [480, 768, 1080, 1440, 1920, 2560, 3200].filter((w) => !image || w <= image.width);
if (image && widths.length === 0) widths.push(image.width);
---

{
  variant === 'background' ? (
    <div class:list={['slot-bg', className]} aria-hidden={alt === '' ? 'true' : undefined}>
      {image ? (
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          priority={priority}
          class="slot-img"
        />
      ) : (
        <p class="slot-bg-label">
          <b>Photo · {name}</b>
          <span>{brief}</span>
        </p>
      )}
    </div>
  ) : (
    <div class:list={['slot', className, { 'has-img': image }]} style={`aspect-ratio: ${ratio}`}>
      {image ? (
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          priority={priority}
          class="slot-img"
        />
      ) : (
        <p class="slot-label">
          <b>Photo · {name}</b>
          {brief}
        </p>
      )}
    </div>
  )
}

<style>
  .slot {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-slot);
    color: var(--color-slot-ink);
  }
  :global(.on-navy) .slot:not(.has-img) {
    background: var(--color-navy-3);
    color: var(--color-inv-muted);
  }
  .slot-label {
    max-width: 36ch;
    padding: 24px;
    text-align: center;
    font-size: 13px;
    line-height: 1.45;
  }
  .slot-label b,
  .slot-bg-label b {
    display: block;
    margin-bottom: 6px;
    font: 600 11px/1.3 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .slot :global(.slot-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Background variant: fills the positioned parent, navy wash keeps text readable */
  .slot-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-navy);
  }
  .slot-bg :global(.slot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .slot-bg:has(:global(.slot-img))::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--hero-scrim);
  }
  .slot-bg-label {
    position: absolute;
    top: 22px;
    right: var(--pad);
    left: var(--pad);
    text-align: right;
    font-size: 12.5px;
    line-height: 1.45;
    color: rgb(244 242 237 / 0.62);
  }
  .slot-bg-label span {
    display: inline-block;
    max-width: 44ch;
  }
</style>
