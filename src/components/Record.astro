---
import SectionHead from './SectionHead.astro';

// Confirmed by the owner. Don't add a stat without a source.
const stats = [
  { n: '20+', label: 'Years in logistics' },
  { n: '2', label: 'Trucks, chilled and frozen' },
  { n: '29', label: 'Pallet spaces (14 + 15)' },
  { n: '6', label: 'Days a week, Sunday to Friday' },
];
---

<section class="sec on-navy" id="record" aria-labelledby="record-h">
  <div class="wrap">
    <SectionHead no="03" label="The record" id="record-h">
      Twenty years of turning up.
      <p slot="lead">
        Over a decade delivering dry goods for restaurant brands, then cold chain. Today we contract to a major NZ cold
        chain operator.
      </p>
    </SectionHead>
    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.n}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    border-top: 1px solid var(--color-inv-line);
    padding-top: 20px;
  }
  dd {
    margin: 0;
    font-size: clamp(52px, 6vw, 92px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }
  dt {
    margin-top: 14px;
    font: 600 12px/1.45 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-inv-muted);
  }
  @media (min-width: 760px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
