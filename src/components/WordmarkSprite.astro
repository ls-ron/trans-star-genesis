---
// The wordmark drawing, defined once per page; Header and Footer reuse it with <use>.
import raw from '../../assets/logo-wordmark.svg?raw';
const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 974 90';
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="ts-wordmark" viewBox={viewBox} set:html={inner} />
</svg>
