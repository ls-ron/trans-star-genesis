---
// Numbered eyebrow in cols 1-3, headline in cols 4-12, optional lead below.
// Usage: <SectionHead no="01" label="The problem" id="problem-h">Headline <em class="hl">phrase.</em><p slot="lead">…</p></SectionHead>
interface Props {
  no: string;
  label: string;
  id: string;
}
const { no, label, id } = Astro.props;
---

<div class="sec-head">
  <span class="label" data-reveal><span class="no">{no}</span> · {label}</span>
  <h2 id={id} data-reveal><slot /></h2>
  <slot name="lead" />
</div>
