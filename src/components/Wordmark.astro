---
// Renders the wordmark from the page's sprite (WordmarkSprite in Base). Text uses currentColor.
import raw from '../../assets/logo-wordmark.svg?raw';
interface Props {
  class?: string;
}
const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 974 90';
---

<svg class={Astro.props.class} viewBox={viewBox} aria-hidden="true" focusable="false"><use href="#ts-wordmark"></use></svg>
