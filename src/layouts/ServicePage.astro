---
// Layout for the service pages and the temperatures guide. Content comes in as data from each page,
// so every page shares the same structure, schema and calls to action.
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CtaPair from '../components/CtaPair.astro';
import FaqList from '../components/FaqList.astro';
import { site } from '../data/site';
import { faqSchema, breadcrumbSchema, serviceSchema, articleSchema, type Faq } from '../data/schema';

interface Block {
  h2: string;
  paras: string[];
  list?: string[];
  after?: string;
}
interface Fact {
  label: string;
  value: string;
  note?: string;
}
interface Props {
  kind: 'service' | 'guide';
  href: string;
  title: string;
  description: string;
  crumb: string;
  eyebrow: string;
  h1: string;
  lead: string;
  serviceType?: string;
  answer?: string;
  blocks: Block[];
  facts?: Fact[];
  faqHeading: string;
  faqs: Faq[];
  related: { href: string; text: string }[];
  sources?: { href: string; text: string }[];
  date?: string;
}
const p = Astro.props;

const schema = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: p.crumb, href: p.href },
  ]),
  p.kind === 'service'
    ? serviceSchema({ name: p.h1, serviceType: p.serviceType ?? p.crumb, description: p.description, href: p.href })
    : articleSchema({ headline: p.h1, description: p.description, href: p.href, date: p.date ?? '2026-10-11' }),
  faqSchema(p.faqs),
];
---

<Base title={p.title} description={p.description} schema={schema}>
  <a class="skip sr-only-focusable" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <section class="on-navy phero" aria-labelledby="page-h">
      <div class="wrap phero-in">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            <li><a href="/">Home</a></li>
            <li aria-current="page">{p.crumb}</li>
          </ol>
        </nav>
        <span class="label eyebrow">{p.eyebrow}</span>
        <h1 id="page-h">{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div>
          <CtaPair id="hero-cta" />
          <p class="note">New customer? Your first delivery is free. <span>One per business.</span></p>
        </div>
      </div>
    </section>

    {
      p.answer && (
        <section class="sec answer-sec" aria-labelledby="answer-h">
          <div class="wrap">
            <div class="answer" data-reveal>
              <h2 id="answer-h">The short answer</h2>
              <p>{p.answer}</p>
            </div>
          </div>
        </section>
      )
    }

    <section class="sec body" aria-label={p.crumb}>
      <div class="wrap blocks">
        {
          p.blocks.map((b) => (
            <div class="block" data-reveal>
              <h2>{b.h2}</h2>
              <div class="text">
                {b.paras.map((t) => (
                  <p>{t}</p>
                ))}
                {b.list && (
                  <ul>
                    {b.list.map((li) => (
                      <li>{li}</li>
                    ))}
                  </ul>
                )}
                {b.after && <p>{b.after}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {
      p.facts && (
        <section class="sec on-navy" aria-labelledby="facts-h">
          <div class="wrap glance">
            <h2 id="facts-h" data-reveal>
              At a glance
            </h2>
            <dl class="facts" data-reveal>
              {p.facts.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>
                    {f.value}
                    {f.note && <small>{f.note}</small>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <section class="sec" aria-labelledby="faq-h">
      <div class="wrap qa">
        <div data-reveal>
          <h2 id="faq-h">{p.faqHeading}</h2>
        </div>
        <div data-reveal>
          <FaqList items={p.faqs} />
          <div class="related">
            <p class="label">Related</p>
            <ul>
              {
                p.related.map((r) => (
                  <li>
                    <a href={r.href}>{r.text} →</a>
                  </li>
                ))
              }
            </ul>
          </div>
          {
            p.sources && (
              <div class="related">
                <p class="label">Sources</p>
                <ul>
                  {p.sources.map((s) => (
                    <li>
                      <a href={s.href} rel="noopener" target="_blank">
                        {s.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section class="sec on-navy cta" aria-labelledby="cta-h">
      <div class="wrap cta-in" data-reveal>
        <h2 id="cta-h">Get a quote. <em class="hl">Or just ring.</em></h2>
        <p>We'll call you back within one business day. Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <CtaPair />
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .phero-in {
    display: grid;
    gap: 20px;
    padding-block: clamp(56px, 8vw, 104px) clamp(48px, 6vw, 80px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: var(--color-inv-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
  }
  .crumbs a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--color-inv-ink);
    text-underline-offset: 3px;
  }
  .eyebrow {
    color: var(--color-inv-muted);
  }
  h1 {
    max-width: 20ch;
    font-weight: 600;
    font-size: clamp(38px, 5.2vw, 76px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .lead {
    max-width: 58ch;
    color: rgb(244 242 237 / 0.86);
    font-size: clamp(17px, 1.35vw, 19px);
  }
  .note {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 600;
  }
  .note span {
    font-weight: 400;
    color: var(--color-inv-muted);
  }

  .answer-sec + .body {
    padding-top: 0;
  }
  .answer {
    max-width: 820px;
    border-left: 4px solid var(--color-red);
    padding: 4px 0 4px clamp(18px, 3vw, 32px);
  }
  .answer h2 {
    font-size: clamp(22px, 2vw, 28px);
    margin-bottom: 12px;
  }
  .answer p {
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .blocks {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }
  .block {
    display: grid;
    gap: 16px;
  }
  .block h2 {
    font-size: clamp(28px, 3vw, 44px);
  }
  .text {
    display: grid;
    gap: 16px;
    max-width: 62ch;
    min-width: 0;
    color: var(--color-ink-2);
    font-size: 17.5px;
  }
  .text ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-ink);
  }
  .text li {
    padding-block: 12px;
    border-bottom: 1px solid var(--color-line);
    font-weight: 600;
    color: var(--color-ink);
  }

  .glance {
    display: grid;
    gap: 28px;
  }
  .glance h2 {
    font-size: clamp(28px, 3vw, 44px);
  }
  .facts {
    margin: 0;
    border-top: 2px solid var(--color-inv-ink);
  }
  .fact {
    display: grid;
    gap: 4px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--color-inv-line);
  }
  dt {
    padding-top: 5px;
    font: 600 11.5px/1.3 var(--font-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-inv-muted);
  }
  dd {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  dd small {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-inv-muted);
  }

  .qa {
    display: grid;
    gap: 28px;
  }
  .qa h2 {
    font-size: clamp(28px, 3vw, 44px);
  }
  .related {
    margin-top: 32px;
  }
  .related .label {
    color: var(--color-muted);
    margin-bottom: 8px;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .related a {
    display: inline-block;
    padding-block: 8px;
    color: var(--color-navy);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .cta-in {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .cta h2 {
    font-size: clamp(36px, 4.6vw, 68px);
    letter-spacing: -0.05em;
  }
  .cta p {
    color: var(--color-inv-muted);
  }
  .cta p a {
    color: var(--color-inv-ink);
    overflow-wrap: anywhere;
  }

  @media (min-width: 760px) {
    .fact {
      grid-template-columns: 200px 1fr;
    }
  }
  @media (min-width: 960px) {
    .block,
    .glance,
    .qa {
      grid-template-columns: 5fr 7fr;
      column-gap: 64px;
      align-items: start;
    }
  }
</style>
