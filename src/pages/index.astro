---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Problem from '../components/Problem.astro';
import WhyWhat from '../components/WhyWhat.astro';
import Record from '../components/Record.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import HowWeWork from '../components/HowWeWork.astro';
import Team from '../components/Team.astro';
import Coverage from '../components/Coverage.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { homeFaqs } from '../data/faqs';
import { faqSchema } from '../data/schema';
---

<Base
  title="Refrigerated Transport Auckland | Chilled & Frozen | TRANS STAR"
  description="Small Auckland refrigerated transport company. Chilled, frozen and dry goods in one load, 2°C to −18°C, Sunday to Friday. First delivery free: 022 075 1526."
  schema={[faqSchema(homeFaqs)]}
>
  <a class="skip sr-only-focusable" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <Hero />
    <Services />
    <Problem />
    <WhyWhat />
    <Record />
    <BeforeAfter />
    <HowWeWork />
    <Team />
    <Coverage />
    <Quote />
  </main>
  <Footer />
  <MobileBar />
</Base>
